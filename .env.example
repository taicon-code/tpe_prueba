# ============================================================
#  .env.example — Copiar como .env y completar con tus datos
#  NUNCA subir el .env real a Git, solo este .env.example
# ============================================================

# Django
# Generar con:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=cambia-esto-por-una-clave-secreta-larga
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost

# Base de datos MySQL
# Usar password fuerte (>=16 chars, mezcla de mayus/minus/digitos/simbolos).
# Crear usuario MySQL dedicado (no root) con permisos solo a db_sumarios_militares.
DB_NAME=db_sumarios_militares
DB_USER=tpe_app
DB_PASSWORD=cambia-esto-por-un-password-fuerte
DB_HOST=127.0.0.1
DB_PORT=3306

# Archivos media (fotos PM, PDFs adjuntos) — apunta a OneDrive o disco externo
# NUNCA dentro del proyecto. Django crea subcarpetas automaticamente.
MEDIA_ROOT=C:/Users/USUARIO/OneDrive/1. TPE/2. TPE GRAL/media_tpe/
MEDIA_URL=/media/
